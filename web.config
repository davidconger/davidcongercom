<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for davidconger.com on Azure App Service (Windows).

  The site had no web.config at all, so every static asset was served with no
  Cache-Control header and no security headers. Only sections that are unlocked
  on App Service are used here; `system.webServer/httpCompression` is locked at
  the server level and is deliberately not touched.

  If anything ever goes wrong after deploying this file, deleting it restores
  the previous behaviour completely - nothing else depends on it.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.htm" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      There were no cache headers on 5.3 GB of photographs, so every asset cost
      a conditional request on each visit. One day is deliberately conservative:
      deployment is a manual FTP copy with no filename fingerprinting, so a
      longer TTL would strand visitors on stale CSS after a change. Moving the
      photo trees to a year-long TTL is part of the CDN split in phase 8, where
      immutable image URLs make it safe.
    -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" path="/404.htm" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <!-- Stops browsers guessing a content type other than the one sent. -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- The photographs are the product; do not let other sites frame them. -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <!-- Send the origin, but never the full path, to other sites. -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Nothing on this site uses these, so switch them off. -->
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), interest-cohort=()" />

        <!--
          HSTS is intentionally NOT enabled yet. It is the one header that can
          lock visitors out irreversibly, so it should only go on once "HTTPS
          Only" is switched on in the App Service portal and both custom domains
          are confirmed to have valid managed certificates. Once that is true,
          uncomment the line below.

          <add name="Strict-Transport-Security" value="max-age=31536000" />
        -->

        <!-- Do not advertise the server stack. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
